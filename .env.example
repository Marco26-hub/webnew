# ============================================================
# Aether — environment variables
# Copy to .env.local and fill in real values. Never commit secrets;
# .env.local is gitignored, this .env.example is the committed template.
# ============================================================

# --- Admin dashboard · database (Neon Postgres) ---------------
# Neon dashboard → Connection string → "Pooled connection".
# Keep the ?sslmode=require suffix (Neon requires TLS).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Admin dashboard · auth (Better Auth) --------------------
# Signs session cookies. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Canonical app URL (production). Optional in local dev.
BETTER_AUTH_URL="https://your-domain.com"

# --- First admin user (read only by `npm run db:seed`) -------
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
SEED_ADMIN_NAME="Your Name"

# --- Contact form email (Resend) -----------------------------
# Without these the form still works (logs only, no email sent).
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL="Aether <onboarding@resend.dev>"
